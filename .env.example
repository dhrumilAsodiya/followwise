# FollowWise environment variables. Names only: never put real values in this file.
# Copy to .env at the repo root (git-ignored). On hosts, set them in the dashboard.
# IMPORTANT: no inline comments after a value. Comments go on their own line,
# because Spring reads this file as .properties and would treat them as part of the value.

# ---- Backend: database (Supabase Postgres, used as plain Postgres)
# Must be a JDBC URL: jdbc:postgresql://HOST:PORT/DBNAME
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=

# ---- Local development only
# Host port for the Docker Compose Postgres. Use 5433 if 5432 is taken. DATABASE_URL must match.
POSTGRES_HOST_PORT=5432

# ---- Backend: auth
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# ---- Backend: app
# Public URL of the frontend, used in email links
APP_BASE_URL=
APP_DEFAULT_TIMEZONE=America/New_York
SCHEDULER_ENABLED=true
# Render sets PORT automatically. Locally the backend defaults to 8080.
# PORT=8080

# ---- Backend: file storage (Supabase Storage, behind a storage interface)
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=documents

# ---- Backend: email (Gmail SMTP now; any provider later by changing these)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# Gmail app password (needs 2-step verification)
MAIL_PASSWORD=
MAIL_FROM_NAME=FollowWise
MAIL_FROM_ADDRESS=
MAIL_REPLY_TO=
# Stay below the Gmail limit of 500 per rolling 24 hours
MAIL_DAILY_CAP=400

# ---- Frontend (Vercel)
# Server-side only. Next.js forwards /api to this URL.
BACKEND_API_URL=
NEXT_PUBLIC_APP_NAME=FollowWise

# ---- Keep-alive (separate public repo: followwise-keepalive)
# HEALTH_URL is set there as a repository variable. It is a public URL, not a secret.
